        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/job/public/recommendations/for-me?topK=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "job",
            "public",
            "recommendations",
            "for-me"
          ],
          "query": [
            {
              "key": "topK",
              "value": "10",
              "description": "Number of recommendations (1-100)"
            }
          ]
        },
        "description": "🎯 Main endpoint: Get personalized job recommendations based on your CV\n\nThis automatically:\n1. Fetches your latest CV from CV Service\n2. Extracts profile text (skills, experience, education)\n3. Sends to ML Recommendation Engine\n4. Returns jobs sorted by relevance score"
      },
      "response": []
